{
  "name": "@docket/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "development": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths && node ../../scripts/mark-cjs.mjs dist",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:prod": "node dist/migrate.js",
    "bootstrap:prod": "node dist/bootstrap.js",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "seed:dummy": "tsx src/seed-dummy.ts",
    "set-password": "tsx src/set-admin-password.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
