# Local development - Docket
DATABASE_URL=postgresql://docket:docket@localhost:5432/docket
JWT_SECRET=dev-jwt-secret-change-me-local-only-32chars
API_PORT=3333
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/tmp/docket-storage
SEED_ADMIN_PASSWORD=DocketAdmin!2026

# Browser talks to the Next app origin; /api/* is rewritten to the Nest API so
# the httpOnly session cookie stays first-party (SameSite=Lax).
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://localhost:3333

# CORS allow-list for the Nest API (direct hits / scripts). Required in prod.
WEB_ORIGIN=http://localhost:3000

# Transactional email (password reset + document nudges). Same verified sender
# for both. Unset = API logs and skips the send (local/tests still boot).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@updates.example.com

# Document AI classification (Reclassify + inbound auto-file). Without this,
# Reclassify returns 503 — it will not silently pretend to look.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
