{
  "name": "@docket/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --conditions development --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node --conditions development --import @swc-node/register/esm-register src/main.ts",
    "build": "swc src -d dist --strip-leading-paths && node ../../scripts/mark-cjs.mjs dist",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-secrets-manager": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@docket/db": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.44.2",
    "express": "^4.22.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.10",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.10.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
